---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>📨 You found stray packets!</h1>
			<p>
				I'm a software engineer with over a decade of experience working
				on web, mobile, crypto and everything in between. Stray packets
				is the place where I share stray thoughts, tech musings with the
				hope that these words <s>written on paper</s> displayed on your screen
				will help or entertain you..
			</p>
		</main>
		<Footer />
	</body>
</html>
